{
  "name": "austin-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "16.x"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "bootstrap": "^4.5.0",
    "cross-env": "^7.0.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-router-dom": "^5.2.0",
    "react-scripts": "3.4.1",
    "serve": "^11.3.2"
  },
  "scripts": {
    "dev": "node --openssl-legacy-provider ./node_modules/react-scripts/bin/react-scripts.js start",
    "start": "serve -s build",
    "build": "node --openssl-legacy-provider ./node_modules/react-scripts/bin/react-scripts.js build",
    "test": "node --openssl-legacy-provider ./node_modules/react-scripts/bin/react-scripts.js test --env=jsdom",
    "eject": "react-scripts eject",
    "heroku-postbuild": "npm run build"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
